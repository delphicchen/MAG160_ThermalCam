__pycache__/
*.pyc
*.pyo
*.npy
*.egg-info/
dist/
build/
.eggs/
*.so
.env
.venv/
venv/
# SR training artifacts (large) — the .onnx model is small and tracked
*.pt
sr_training_frames.npy

# large reverse-engineering artifacts / proprietary blobs (regenerate from the
# device + the recon scripts; see recon/EMULATION_NUC.md).
# mag_cali.bin, emu_heap.bin:
*.bin
# block montages / scratch renders:
android2/recon/*.png
android2/recon/blocks/
android2/recon/proper_blocks/
android2/recon/test_offsets/
# superseded intermediate + single-temp dump (the runtime grid .npz is tracked):
android2/recon/factory_gain_offset.npz
android2/recon/factory_nuc_tables.npz

# per-camera / personal captures (not portable between cameras)
gain_nuc.npz
flatfield.npy
*.ddt

# required runtime data, kept despite the blanket *.npy ignore above
!android2/recon/planck_luts.npy

# Android gradle/IDE caches + local SDK path (android2)
.gradle/
.kotlin/
local.properties


# trained SR checkpoints (restore from a Colab progress zip)
sr_train/checkpoints/
# the bundled thermal SR model ships inside the APK
!android2/app/src/main/assets/model/*.bin
